From 386ebc4ed26211c0347ac6dba7a56784b9b3ab6a Mon Sep 17 00:00:00 2001
From: Sreeram S <sreeram@users.noreply.github.com>
Date: Tue, 17 Nov 2026 14:37:24 +0000
Subject: [PATCH] launcher: green-glass, green-rim and green-halo focus styles

Three more glass_style values: the glass, rim and halo looks with a green
(#34C759) rim and outer glow; green-glass also tints its frosted fill. The
default stays glass. A festive or cinematic accent still overrides the colour
as before; setAccent(0) now returns to the style's own colour.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01JNks2QG6pJ57GLCSB3q7K5
---
 .../main/java/com/gathin/tvhome/Config.java   |  7 ++++-
 .../java/com/gathin/tvhome/GlassView.java     | 26 ++++++++++++++-----
 launcher/app/src/main/res/values/config.xml   |  4 ++-
 .../com/gathin/tvhome/GlassStyleTest.java     |  7 +++++
 tests/test_shipped_config_values.py           |  5 ++--
 themes/README.md                              |  2 +-
 tools/manage.py                               |  2 +-
 7 files changed, 41 insertions(+), 12 deletions(-)

diff --git a/launcher/app/src/main/java/com/gathin/tvhome/Config.java b/launcher/app/src/main/java/com/gathin/tvhome/Config.java
index 0d336c94..df397ef6 100644
--- a/launcher/app/src/main/java/com/gathin/tvhome/Config.java
+++ b/launcher/app/src/main/java/com/gathin/tvhome/Config.java
@@ -254,11 +254,13 @@ final class Config {
     final Map<String, Set<String>> wallpaperMoods;
     /** Shape of the glow behind the focused app (config.xml, glow_style): {@link #GLOW_RADIAL} or {@link #GLOW_HORIZON}. */
     final String glowStyle;
-    /** The focus highlight's look (config.xml, glass_style): {@link #GLASS_DEFAULT}, {@link #GLASS_RIM} or {@link #GLASS_HALO}. */
+    /** The focus highlight's look (config.xml, glass_style): {@link #GLASS_DEFAULT}, {@link #GLASS_RIM}, {@link #GLASS_HALO},
+     *  or one of them in green: {@link #GLASS_GREEN}, {@link #GLASS_GREEN_RIM}, {@link #GLASS_GREEN_HALO}. */
     final String glassStyle;
 
     static final String GLOW_RADIAL = "radial", GLOW_HORIZON = "horizon";
     static final String GLASS_DEFAULT = "glass", GLASS_RIM = "rim", GLASS_HALO = "halo";
+    static final String GLASS_GREEN = "green-glass", GLASS_GREEN_RIM = "green-rim", GLASS_GREEN_HALO = "green-halo";
     /** Show each rotating wallpaper's name from wallpapers/captions.txt (config.xml / theme wallpaper_captions). */
     final boolean wallpaperCaptions;
     /** Answer VIEW_INPUTS with the Inputs menu (handle_view_inputs); see InputsRequestActivity. */
@@ -431,6 +433,9 @@ final class Config {
         if (value == null) return GLASS_DEFAULT;
         String v = value.trim();
         if (GLASS_RIM.equalsIgnoreCase(v)) return GLASS_RIM;
+        if (GLASS_GREEN.equalsIgnoreCase(v)) return GLASS_GREEN;
+        if (GLASS_GREEN_RIM.equalsIgnoreCase(v)) return GLASS_GREEN_RIM;
+        if (GLASS_GREEN_HALO.equalsIgnoreCase(v)) return GLASS_GREEN_HALO;
         return GLASS_HALO.equalsIgnoreCase(v) ? GLASS_HALO : GLASS_DEFAULT;
     }
 
diff --git a/launcher/app/src/main/java/com/gathin/tvhome/GlassView.java b/launcher/app/src/main/java/com/gathin/tvhome/GlassView.java
index 0fd2b6cd..6673d0ef 100644
--- a/launcher/app/src/main/java/com/gathin/tvhome/GlassView.java
+++ b/launcher/app/src/main/java/com/gathin/tvhome/GlassView.java
@@ -29,6 +29,9 @@ public class GlassView extends View {
     /** glass_style rim or halo: no sheen and no fill, only the crisp rim (and, for halo, a lighter outer glow). */
     private boolean flat;
     private boolean halo;
+    /** glass_style green-glass, green-rim or green-halo: the same look with a green rim, glow and (glass) fill. */
+    private boolean green;
+    private static final int GREEN_RGB = 0x34C759;
 
     public GlassView(Context context, AttributeSet attrs) {
         super(context, attrs);
@@ -47,9 +50,9 @@ public class GlassView extends View {
     /** Tints the rim and the outer glow; 0 restores the plain white glass. */
     void setAccent(int argb) {
         if (argb == 0) {
-            glowRgb = 0xFFFFFF;
-            glowAlpha = 0x30;
-            rim.setColor(0xCCFFFFFF);
+            glowRgb = green ? GREEN_RGB : 0xFFFFFF;
+            glowAlpha = green ? 0x60 : 0x30;
+            rim.setColor(green ? 0xE6000000 | GREEN_RGB : 0xCCFFFFFF);
         } else {
             glowRgb = argb & 0xFFFFFF;
             glowAlpha = 0x70;
@@ -63,9 +66,14 @@ public class GlassView extends View {
 
     /** One of Config's GLASS_* styles. */
     void setStyle(String style) {
-        flat = Config.GLASS_RIM.equals(style) || Config.GLASS_HALO.equals(style);
-        halo = Config.GLASS_HALO.equals(style);
+        green = Config.GLASS_GREEN.equals(style) || Config.GLASS_GREEN_RIM.equals(style)
+                || Config.GLASS_GREEN_HALO.equals(style);
+        flat = Config.GLASS_RIM.equals(style) || Config.GLASS_HALO.equals(style)
+                || Config.GLASS_GREEN_RIM.equals(style) || Config.GLASS_GREEN_HALO.equals(style);
+        halo = Config.GLASS_HALO.equals(style) || Config.GLASS_GREEN_HALO.equals(style);
         rim.setStrokeWidth((flat ? 2f : 1.5f) * density);
+        setAccent(0);   // the plain colours of this style (white, or green); a festive accent is set again after
+        if (getWidth() > 0) updateFill(getHeight());
         invalidate();
     }
 
@@ -77,7 +85,13 @@ public class GlassView extends View {
     @Override
     protected void onSizeChanged(int w, int h, int oldw, int oldh) {
         super.onSizeChanged(w, h, oldw, oldh);
-        fill.setShader(new LinearGradient(0, 0, 0, h, 0x3DFFFFFF, 0x12FFFFFF, Shader.TileMode.CLAMP));
+        updateFill(h);
+    }
+
+    /** The slab's fill: clear white glass, or lightly green-tinted glass for green-glass. */
+    private void updateFill(int h) {
+        int rgb = green ? GREEN_RGB : 0xFFFFFF;
+        fill.setShader(new LinearGradient(0, 0, 0, h, 0x3D000000 | rgb, 0x12000000 | rgb, Shader.TileMode.CLAMP));
         specular.setShader(new LinearGradient(0, 0, 0, h * 0.45f, 0x66FFFFFF, 0x00FFFFFF, Shader.TileMode.CLAMP));
     }
 
diff --git a/launcher/app/src/main/res/values/config.xml b/launcher/app/src/main/res/values/config.xml
index a32a1068..18504e9c 100644
--- a/launcher/app/src/main/res/values/config.xml
