@@ -19,6 +19,13 @@ public class GlassStyleTest {
         assertEquals(Config.GLASS_HALO, Config.glassStyle("HALO "));
     }
 
+    @Test
+    public void greenStylesByNameAnyCase() {
+        assertEquals(Config.GLASS_GREEN, Config.glassStyle("green-glass"));
+        assertEquals(Config.GLASS_GREEN_RIM, Config.glassStyle(" Green-Rim "));
+        assertEquals(Config.GLASS_GREEN_HALO, Config.glassStyle("GREEN-HALO"));
+    }
+
     @Test
     public void anythingElseIsGlass() {
         assertEquals(Config.GLASS_DEFAULT, Config.glassStyle("glass"));
diff --git a/tests/test_shipped_config_values.py b/tests/test_shipped_config_values.py
index 4748eb97..b23fa9b9 100644
--- a/tests/test_shipped_config_values.py
+++ b/tests/test_shipped_config_values.py
@@ -214,7 +214,8 @@ class ShippedConfigValuesTest(unittest.TestCase):
     def test_the_enum_values_are_read_out_of_the_launcher(self):
         # A constant parse that found nothing would let every value through, the way it did for "off".
         self.assertEqual(self.enums.get("glow_style"), ({"radial", "horizon"}, "trimmed"))
-        self.assertEqual(self.enums.get("glass_style"), ({"glass", "rim", "halo"}, "trimmed"))
+        self.assertEqual(self.enums.get("glass_style"),
+                         ({"glass", "rim", "halo", "green-glass", "green-rim", "green-halo"}, "trimmed"))
         self.assertEqual(self.enums.get("wallpaper_order"), ({"sequential", "shuffle"}, "exact"))
 
     def test_a_value_outside_the_set_is_reported(self):
@@ -222,7 +223,7 @@ class ShippedConfigValuesTest(unittest.TestCase):
         # glowStyle() answered radial. The spelling is the reader's - glow and glass trim and ignore
         # case, validOrder() does not, so `Sequential` is not `sequential`.
         for key, value, listed in (("glow_style", "off", "horizon, radial"),
-                                   ("glass_style", "frosted", "glass, halo, rim"),
+                                   ("glass_style", "frosted", "glass, green-glass, green-halo, green-rim, halo, rim"),
                                    ("wallpaper_order", "Sequential", "sequential, shuffle")):
             with self.subTest(key=key, value=value):
                 reported = dict(problems({key: value}, self.kinds, self.enums))
diff --git a/themes/README.md b/themes/README.md
index af5d0d01..ac46fbbe 100644
--- a/themes/README.md
+++ b/themes/README.md
@@ -194,7 +194,7 @@ A new key needs one there in the same pull request.
 | `clock_wallpaper_dim` | 0 to 90 | How dark that wallpaper is behind the clock, in percent (50 by default) |
 | `clock_glow` | bool | The clock screensaver's coloured glow (`true` by default); `false` leaves the moving clock on plain black, e.g. for an OLED |
 | `glow_style` | string | Shape of the glow behind the focused app, in its colour: `radial` (default) or `horizon`, the colour washing down from the top edge to black; the cinematic shelf keeps its own. Any other value falls back to `radial`; there is no value for "none", so a theme without a glow sets `ambient_glow` and `app_glow` to `false` |
-| `glass_style` | string | Look of the focus highlight: `glass` (default: a translucent slab with a bright top sheen, a crisp rim and a faint outer glow), `rim` (the crisp rim alone, no sheen, fill or glow, for a quiet focus over a wallpaper) or `halo` (the rim with a lighter outer glow). Any other value falls back to `glass` |
+| `glass_style` | string | Look of the focus highlight: `glass` (default: a translucent slab with a bright top sheen, a crisp rim and a faint outer glow), `rim` (the crisp rim alone, no sheen, fill or glow, for a quiet focus over a wallpaper) or `halo` (the rim with a lighter outer glow); `green-glass`, `green-rim` and `green-halo` are the same looks with a green rim and glow (`green-glass` also tints its fill). Any other value falls back to `glass` |
 | `cinematic_home` | bool | Cinematic top shelf: the focused dock app's artwork, softened, fills the top of the screen in its colour, with a larger name, "Last opened" (apps opened from Home), dock position dots, a focus glow in the app's colour and a translucent dock band; off by default |
 | `cinematic_dots` | bool | With `cinematic_home`, the dock position dots under the app's name (`true` by default); `false` leaves them out |
 | `cinematic_white_focus` | bool | With `cinematic_home`, the focus highlight stays white on the dock instead of taking the focused app's colour (`false` by default); `app_glow` still colours every tile |
