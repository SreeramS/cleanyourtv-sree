{"argv": ["tv.py", "p=$(pidof com.gathin.tvhome); top -b -n 1 -p $p | tail -2; cat /proc/$p/task/$p/stat | cut -d\" \" -f3,14,15; sleep 2; cat /proc/$p/task/$p/stat | cut -d\" \" -f3,14,15; dumpsys input | grep -m3 -i -E \"waitQueue|anr|com.gathin.tvhome.*(Paused|wait)\"; logcat -d -v time | grep -E \"19:5[0-3]\" | grep -i -E \"gathin|tvhome|ANR|Choreographer|Skipped\" | tail -12"], "timeout": 60}