{"argv": ["tv.py", "p=$(pidof com.gathin.tvhome); logcat -d --pid=$p -v time | grep -v -E \"ApkAssets|libc \" | grep -E \"19:5[7-9]\" | tail -15; echo ---; dumpsys gfxinfo com.gathin.tvhome framestats | grep -A3 \"---PROFILEDATA---\" | head -5; dumpsys SurfaceFlinger --vsync 2>/dev/null | head -10; dumpsys SurfaceFlinger | grep -m5 -i -E \"vsync|refresh-rate|VSYNC\""], "timeout": 60}