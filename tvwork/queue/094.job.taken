{"argv": ["tv.py", "logcat -d -v time -s TvHome:* | tail -20; echo ---; logcat -b events -d -v time | grep -E \"20:0[0-6]\" | grep -E \"screen_toggled|am_proc_start.*tvhome|am_proc_died.*tvhome|am_kill.*tvhome|power_sleep_requested|boot_progress_start\" | tail -20; dumpsys gfxinfo com.gathin.tvhome | grep -m1 \"Total frames\"; dumpsys package com.gathin.tvhome | grep -m1 lastUpdateTime"], "timeout": 60}