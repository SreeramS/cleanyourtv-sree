{"argv": ["tv.py", "pm list packages -3; echo ---; for p in com.google.android.youtube.tv com.netflix.ninja com.amazon.amazonvideo.livingroom com.google.android.katniss com.google.android.apps.mediashell com.google.android.youtube.tvmusic com.graymatrix.did in.startv.hotstar com.jio.jioplay.tv com.google.android.tts com.google.android.backdrop; do pm list packages $p | grep -qx \"package:$p\" && echo \"HAVE $p\"; done"], "timeout": 60}