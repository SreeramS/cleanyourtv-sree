{"argv": ["tv.py", "logcat -b events -d -v time | grep -E \"19:5[67]\" | grep -E \"screen_toggled|power_sleep_requested|DigitalChannelSetupActivity.*(resume|create)|wm_on_create_called.*tvhome|am_proc_start.*tvhome\" | head -20; dumpsys gfxinfo com.gathin.tvhome | grep -m1 \"Total frames\"; input keyevent DPAD_RIGHT; sleep 1.5; dumpsys gfxinfo com.gathin.tvhome | grep -m1 \"Total frames\""], "timeout": 60}