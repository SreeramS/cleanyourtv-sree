{"argv": ["tv.py", "dumpsys power | grep -m1 mWakefulness=; dumpsys gfxinfo com.gathin.tvhome | grep -m2 -E \"Total frames rendered|Janky\"; input keyevent DPAD_LEFT; sleep 2; dumpsys gfxinfo com.gathin.tvhome | grep -m1 \"Total frames rendered\"; dumpsys window windows | grep -A30 \"com.gathin.tvhome/com.gathin.tvhome.MainActivity}\" | grep -m6 -E \"mHasSurface|isVisible|mViewVisibility|mDrawState|isOnScreen|mAppFreezing\""], "timeout": 60}